generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id       Int    @id @default(autoincrement())
  name     String
  province String
  country  String
  users    User[]

  @@unique([name, province, country])
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  level              Int?
  position           Position?
  role               UserRole            @default(PLAYER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  avatar             String?
  bio                String?
  birthDate          DateTime?
  cityId             Int?
  dominantHand       DominantHand?
  emailVerified      Boolean             @default(false)
  firstName          String
  instagram          String?
  isActive           Boolean             @default(true)
  lastName           String
  latitude           Float?
  longitude          Float?
  phone              String?
  preferredMatchType PreferredMatchType?
  profileCompleted   Boolean             @default(false)
  travelDistanceKm   Int?                @default(20)
  whatsapp           String?
  city               City?               @relation(fields: [cityId], references: [id])
}

enum UserRole {
  PLAYER
  CLUB_ADMIN
  ADMIN
}

enum Position {
  DRIVE
  REVES
  BOTH
}

enum DominantHand {
  RIGHT
  LEFT
}

enum PreferredMatchType {
  SOCIAL
  COMPETITIVE
  BOTH
}
