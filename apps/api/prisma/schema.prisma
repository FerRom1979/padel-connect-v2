generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id          Int          @id @default(autoincrement())
  name        String
  province    String
  country     String
  users       User[]
  matches     Match[]
  clubs       Club[]
  tournaments Tournament[]

  @@unique([name, province, country])
}

model User {
  id                   String                   @id @default(uuid())
  email                String                   @unique
  password             String
  category             PlayerCategory?
  position             Position?
  role                 UserRole                 @default(PLAYER)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  avatar               String?
  bio                  String?
  birthDate            DateTime?
  cityId               Int?
  dominantHand         DominantHand?
  emailVerified        Boolean                  @default(false)
  firstName            String
  instagram            String?
  isActive             Boolean                  @default(true)
  lastName             String
  latitude             Float?
  longitude            Float?
  phone                String?
  preferredMatchType   PreferredMatchType?
  profileCompleted     Boolean                  @default(false)
  travelDistanceKm     Int?                     @default(20)
  whatsapp             String?
  city                 City?                    @relation(fields: [cityId], references: [id])
  organizedMatches     Match[]                  @relation("MatchOrganizer")
  matchPlayers         MatchPlayer[]
  createdClubs         Club[]                   @relation("ClubCreator")
  organizedTournaments Tournament[]             @relation("TournamentOrganizer")
  tournamentEntries    TournamentRegistration[]
}

enum UserRole {
  PLAYER
  CLUB_ADMIN
  ADMIN
}

enum Position {
  DRIVE
  REVES
  BOTH
}

enum DominantHand {
  RIGHT
  LEFT
}

enum PreferredMatchType {
  SOCIAL
  COMPETITIVE
  BOTH
}

/// Un partido de pádel: 2v2, siempre 4 jugadores. El organizador ocupa un lugar.
/// La sede puede ser un Club cargado o texto libre: no todo partido se juega
/// en un club que esté en la app. Si hay club, venueName se copia de ahí.
model Match {
  id          String           @id @default(uuid())
  organizerId String
  venueName   String
  clubId      String?
  cityId      Int
  latitude    Float?
  longitude   Float?
  playedAt    DateTime
  durationMin Int              @default(90)
  categories  PlayerCategory[]
  notes       String?
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  organizer User          @relation("MatchOrganizer", fields: [organizerId], references: [id])
  city      City          @relation(fields: [cityId], references: [id])
  club      Club?         @relation(fields: [clubId], references: [id])
  players   MatchPlayer[]

  @@index([cityId, playedAt])
  @@index([playedAt])
}

/// Quién está anotado. Sin estados: el que llega primero entra.
model MatchPlayer {
  matchId  String
  userId   String
  joinedAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
  @@index([userId])
}

/// Categorías del pádel argentino: caballeros C1..C8, damas D1..D7.
/// OJO con el orden: el número MÁS BAJO es el MEJOR jugador.
/// C1 es profesional y C8 principiante; en damas, D1 profesional y D7 principiante.
enum PlayerCategory {
  C1
  C2
  C3
  C4
  C5
  C6
  C7
  C8
  D1
  D2
  D3
  D4
  D5
  D6
  D7
}

/// Un club con canchas. Lo carga cualquier jugador: la idea es que el mapa
/// lo llene la comunidad, no un alta manual.
model Club {
  id          String   @id @default(uuid())
  name        String
  cityId      Int
  address     String?
  courts      Int?
  phone       String?
  website     String?
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city        City         @relation(fields: [cityId], references: [id])
  createdBy   User         @relation("ClubCreator", fields: [createdById], references: [id])
  matches     Match[]
  tournaments Tournament[]

  /// Dos clubes con el mismo nombre en la misma ciudad son el mismo club.
  @@unique([name, cityId])
  @@index([cityId])
}

/// Torneo. La sede sigue la misma regla que en Match: Club opcional o texto libre.
model Tournament {
  id          String           @id @default(uuid())
  name        String
  venueName   String
  clubId      String?
  cityId      Int
  startDate   DateTime
  endDate     DateTime?
  categories  PlayerCategory[]
  maxTeams    Int?
  /// Inscripción por pareja, en pesos.
  price       Int?
  description String?
  cancelledAt DateTime?
  organizerId String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  city          City                     @relation(fields: [cityId], references: [id])
  club          Club?                    @relation(fields: [clubId], references: [id])
  organizer     User                     @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  registrations TournamentRegistration[]

  @@index([cityId, startDate])
  @@index([startDate])
}

/// El pádel se juega en parejas, pero exigir que el compañero ya esté en la app
/// dejaría afuera media inscripción. Se anota uno y nombra al compañero.
model TournamentRegistration {
  tournamentId String
  userId       String
  category     PlayerCategory
  partnerName  String?
  createdAt    DateTime       @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
  @@index([userId])
}
